# Copy this file to .env.local and fill in the values from:
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration
# (.env.local is gitignored; these are client-side keys, not secrets, but keep them out of the repo anyway)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (needed when App Check is enforced for Firebase AI Logic):
# reCAPTCHA Enterprise site key — public, safe to ship in the build
VITE_RECAPTCHA_SITE_KEY=
# localhost only: a debug token registered in Firebase console → App Check → Apps → Manage debug tokens
VITE_APPCHECK_DEBUG_TOKEN=
